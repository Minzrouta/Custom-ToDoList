# .env.example — Copier en .env pour le dev local
# En production (Coolify), ces variables sont injectées via l'UI Coolify.
# NE JAMAIS commit un .env réel (gitignored).

# ─── Base de données ─────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/custom_todolist"

# Pour Docker Compose database service :
POSTGRES_DB="custom_todolist"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"

# ─── NextAuth.js ─────────────────────────────────────────────
# URL publique de l'app (pour les callbacks OAuth)
NEXTAUTH_URL="http://localhost:3000"
# Secret : openssl rand -base64 32
NEXTAUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"

# OAuth Google — https://console.cloud.google.com → Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OAuth GitHub — https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─── URLs publiques (baked au build pour Next.js) ────────────
# En prod Coolify : passer aussi dans build.args du compose
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Discord bot ─────────────────────────────────────────────
# Token du bot — https://discord.com/developers/applications
DISCORD_TOKEN=""
# Application ID (pour register-commands)
DISCORD_CLIENT_ID=""
# URL interne du service notify (par défaut OK en docker compose)
DISCORD_BOT_NOTIFY_URL="http://discord-bot:8080/notify"
# Port HTTP interne du bot (défaut 8080)
NOTIFY_PORT="8080"
