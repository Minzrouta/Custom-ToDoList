# .env.example — Copier en .env pour le développement local
# Ces variables sont injectées par Coolify en production (ne pas committer .env)

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/custom_todolist"

# Next.js (optionnel en dev)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
